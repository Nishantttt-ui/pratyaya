# ---------------------------------------------------------------------------
# Pratyaya - example environment file.
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Any PostgreSQL 15+ with the `vector` extension available.
# Local:  postgresql+psycopg://pratyaya:pratyaya@localhost:5432/pratyaya
# Neon :  postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql+psycopg://pratyaya:pratyaya@localhost:5432/pratyaya

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# --- AI layer -------------------------------------------------------------
# The decisioning model NEVER depends on this. The LLM only produces
# natural-language explanations of a decision that has already been made.
# One of: gemini | groq | ollama | bedrock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=20

# Only the key for the selected provider needs to be set.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Bedrock: credentials resolve via the standard AWS chain (IAM role, profile,
# or environment) - they are deliberately not read from this file.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Retrieval ------------------------------------------------------------
# Runs locally via ONNX. No API key, no network call, no per-query cost.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=4
