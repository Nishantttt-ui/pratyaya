# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data: large / licensed, not redistributed ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts ---
ml/artifacts/*
!ml/artifacts/.gitkeep

# --- Node ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- frontend build output ---
frontend/dist/
frontend/node_modules/
