# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data ---
# Build outputs, regenerated from a fixed seed by scripts/train.py. The
# committed sample at data/sample_applications.csv shows the shape without
# carrying five megabytes of generated rows in the history.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts ---
ml/artifacts/*
!ml/artifacts/.gitkeep

# --- Node ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- frontend build output ---
frontend/dist/
frontend/node_modules/

# deck generator deps
scripts/deck/node_modules/

# Office lock files
~$*
